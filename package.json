{
  "name": "fitness-ecosystem",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": ["apps/web", "backend", "packages/*"],
  "scripts": {
    "build": "npm run build --workspace=@fitness/backend && npm run build --workspace=@fitty/nutrition-web",
    "build:web": "npm run build --workspace=@fitty/nutrition-web",
    "test": "npm run test --workspace=@fitness/backend",
    "lint": "npm run lint --workspace=@fitness/backend",
    "dev:backend": "npm run start:dev --workspace=@fitness/backend",
    "dev:web": "npm run dev --workspace=@fitty/nutrition-web",
    "start:mobile": "npm --prefix apps/mobile run start",
    "check:mobile": "npm --prefix apps/mobile run check"
  }
}
